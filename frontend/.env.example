# API base URL.
# - `/api` (default) — same-origin: the dev server proxies to the backend and
#   the production build expects a reverse proxy from the static host.
# - `https://your-backend.onrender.com/api` — cross-origin backend (CORS is
#   configured on the backend via CORS_ORIGINS).
VITE_API_URL=/api

# Local browser development without a Telegram client.
# Set to true only on your machine; the backend must also run with DEV_AUTH=true.
VITE_DEMO_MODE=false

# Optional: label shown in the footer of the profile screen.
VITE_SUPPORT_URL=https://t.me/
