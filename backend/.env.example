# ---------------------------------------------------------------------------
# GIFT MARKET backend configuration
# Copy to .env and fill in the values. Never commit real secrets.
# ---------------------------------------------------------------------------

# development | staging | production
ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api

# --- Database --------------------------------------------------------------
# Local development may use SQLite: sqlite:///./gift_market.db
# Production MUST use PostgreSQL (the app refuses to start otherwise).
DATABASE_URL=sqlite:///./gift_market.db
# DATABASE_URL=postgresql+psycopg://gift:gift@localhost:5432/giftmarket
DB_ECHO=false

# --- Telegram bot ----------------------------------------------------------
# Token from @BotFather. Required for real Stars payments and initData checks.
BOT_TOKEN=
BOT_USERNAME=
# Public HTTPS URL of the Mini App (frontend).
WEBAPP_URL=
# Public HTTPS URL of this backend (used by the webhook setup button).
PUBLIC_BASE_URL=
# Random string; must match the secret_token used in setWebhook.
WEBHOOK_SECRET=
# Reject initData older than this many seconds (86400 = 24h).
INIT_DATA_MAX_AGE_SECONDS=86400

# --- Access control --------------------------------------------------------
# Comma separated numeric Telegram IDs that get the superadmin role.
ADMIN_TELEGRAM_IDS=
# Local browser development without Telegram. MUST be false in production.
DEV_AUTH=true
DEMO_TELEGRAM_ID=900000001

# --- CORS / hosts ----------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=*

# --- Marketplace defaults (editable in the admin panel afterwards) ---------
COMMISSION_PERCENT=10
MIN_LISTING_PRICE=10
MAX_LISTING_PRICE=100000
BALANCE_HOLD_HOURS=72
LISTING_RESERVATION_MINUTES=20

# --- Rate limits (requests/window seconds) ---------------------------------
RATE_LIMIT_AUTH=60/60
RATE_LIMIT_WRITE=60/60
RATE_LIMIT_CHECKOUT=15/60
RATE_LIMIT_READ=300/60

# --- Optional TON integration ---------------------------------------------
# Used only to check that an address exists on chain. No minting happens here.
TONAPI_BASE_URL=https://tonapi.io
TONAPI_KEY=
