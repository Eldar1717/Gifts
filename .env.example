# Root environment for docker-compose (database credentials + compose switches).
# Copy to `.env` next to docker-compose.yml and change the password.

POSTGRES_USER=gift
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=giftmarket
POSTGRES_PORT=5432

# production | staging | development  (production enables strict config guards)
ENV=production
WEB_CONCURRENCY=2
# Set to true only for a demo deployment; seeds a catalogue on first start.
SEED_DEMO_DATA=false
